{
  "schema_version": 1,
  "stage": "P0",
  "parent_protocol": "pilot_protocol.json",
  "seed": 100,
  "model": "unadapted Qwen2.5-VL-3B-Instruct",
  "prompt": "reason",
  "assistant_prefix": "\\boxed{",
  "split": "validation",
  "validation_counts": {"Fundus": 544, "Dermoscopy": 674},
  "evaluation_questions": {"Fundus": 544, "Dermoscopy": 300},
  "rollouts": 16,
  "agreement_band_votes": [10, 14],
  "grounding": {"evidence_ratio": 1.5, "temperature": 0.1, "min_weight": 0.1},
  "high_weight_threshold": 0.5,
  "min_accuracy_gap": 0.05,
  "min_auroc": 0.60,
  "min_eligible_fraction": 0.20,
  "counterfactual_pool": "same_modality_train_after_image_exclusions",
  "require_same_source_when_possible": true,
  "exclude_images_from": ["all_stage_a_validation", "all_test", "dermoscopy_confirmation_holdout", "xray_confirmation_holdout_if_created"],
  "choice_priority": ["counterfactual", "black"],
  "all_modalities_required": true,
  "tie_or_no_valid_vote": "exclude_from_evidence_metrics",
  "on_failure": "stop_and_report",
  "projected_wall_limit_seconds": 72000,
  "max_wall_seconds": 82800,
  "output_guard_bytes": 2000000000
}
