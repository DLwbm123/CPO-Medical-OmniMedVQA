{
  "schema_version": 1,
  "stage": "D",
  "task": "Fundus",
  "parent_protocol": "pilot_protocol.json",
  "precheck_protocol": "precheck_protocol.json",
  "seed": 100,
  "updates": 200,
  "prompts_per_update": 4,
  "voting_rollouts": 16,
  "training_rollouts": 8,
  "agreement_band_votes": [10, 14],
  "kl_beta": 0.04,
  "guard_reference_questions": 200,
  "guard_window_questions": 50,
  "guard_max_tv": 0.15,
  "guard_max_consecutive_steps": 20,
  "adapter": {
    "rank": 32,
    "alpha": 64,
    "dropout": 0,
    "bias": "none",
    "language_projections": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
    "visual_merger_linears": true,
    "freeze_vision_encoder": true,
    "learning_rate": 0.00005,
    "reference": "same_base_with_adapter_disabled"
  },
  "m1": {
    "evidence_ratio": 1.5,
    "weight_temperature": 0.1,
    "min_weight": 0.1,
    "blind_kl_budget_nats": 0.02,
    "dual_init": 1.0,
    "dual_min": 0.1,
    "dual_max": 100.0,
    "dual_increase_factor": 2.0,
    "dual_decrease_factor": 0.5,
    "dual_low_budget_fraction": 0.5,
    "audit_every_steps": 10,
    "audit_questions": 100,
    "use_four_question_mean_for_training_kl": true
  },
  "m2": {"confidence_cap": 0.9},
  "m3": {"adapter_only": true, "decision_memory_in_pilot": false},
  "policy_weighting": "multiply_group_standardized_advantages",
  "preserve_completion_mask": true,
  "skip_optimizer_when_all_policy_advantages_zero": true,
  "training_arms": ["tt_gc"],
  "reference_arms": ["frozen_constrained", "completed_full_parameter_tt_v0"],
  "full_parameter_reference_run": "run20",
  "development_reference_aggregates": ["decision_diagnostic_result.json"],
  "evaluate_target_views": ["real", "counterfactual", "black"],
  "gate": {
    "min_real_gain_over_frozen": 0.02,
    "max_black_gain_fraction_of_full_parameter_tt_v0": 0.5,
    "max_high_confidence_errors_fraction_of_full_parameter_tt_v0": 0.5,
    "max_other_modality_drop": 0.05,
    "require_all": true
  },
  "frozen_decoding": {"assistant_prefix": "\\boxed{", "confidence_cutoff": 0.9, "selective_coverage": 0.25},
  "single_gpu_if_verified": true,
  "on_failure": "stop_and_report_no_self_retuning",
  "projected_wall_limit_seconds": 72000,
  "max_wall_seconds": 82800,
  "output_guard_bytes": 18000000000
}
